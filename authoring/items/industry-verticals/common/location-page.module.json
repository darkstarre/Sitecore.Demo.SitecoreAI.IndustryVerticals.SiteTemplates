{
  "$schema": "../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "Project.IndustryVerticals.LocationPage",
  "items": {
    "includes": [
      {
        "name": "templatesProject",
        "path": "/sitecore/templates/Project/industry-verticals",
        "rules": [
          {
            "path": "/Pages",
            "scope": "SingleItem",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "/Pages/LocationPage",
            "scope": "ItemAndDescendants",
            "allowedPushOperations": "CreateAndUpdate"
          },
          {
            "path": "*",
            "scope": "Ignored"
          }
        ]
      }
    ]
  }
}
