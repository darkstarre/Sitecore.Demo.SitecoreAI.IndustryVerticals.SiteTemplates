{
  "$schema": "../.sitecore/schemas/ModuleFile.schema.json",
  "namespace": "Project.Uchicago-Content",
  "references": [
    "Project.IndustryVerticals"
  ],
  "items": {
    "includes": [
      {
        "name": "uchicago-site-root",
        "path": "/sitecore/content/industry-verticals/uchicago",
        "scope": "SingleItem",
        "allowedPushOperations": "CreateAndUpdate"
      },
      {
        "name": "healthcare-home",
        "path": "/sitecore/content/industry-verticals/uchicago/home",
        "scope": "ItemAndDescendants",
        "allowedPushOperations": "CreateAndUpdate"
      },
      {
        "name": "healthcare-media",
        "path": "/sitecore/content/industry-verticals/uchicago/Media",
        "scope": "DescendantsOnly",
        "allowedPushOperations": "CreateAndUpdate"
      },
      {
        "name": "healthcare-data",
        "path": "/sitecore/content/industry-verticals/uchicago/Data",
        "scope": "DescendantsOnly",
        "allowedPushOperations": "CreateAndUpdate"
      },
      {
        "name": "healthcare-dictionary",
        "path": "/sitecore/content/industry-verticals/uchicago/Dictionary",
        "scope": "DescendantsOnly",
        "allowedPushOperations": "CreateAndUpdate"
      },
      {
        "name": "healthcare-presentation",
        "path": "/sitecore/content/industry-verticals/uchicago/Presentation",
        "scope": "DescendantsOnly",
        "allowedPushOperations": "CreateAndUpdate"
      }
    ]
  }
}
