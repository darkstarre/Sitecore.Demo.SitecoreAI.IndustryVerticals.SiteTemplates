# Copy this file to `.env.local` and fill in values for your XM Cloud environment.

# Required for Content SDK edge requests
SITECORE_EDGE_CONTEXT_ID=
NEXT_PUBLIC_SITECORE_EDGE_CONTEXT_ID=
SITECORE_EDGE_URL=https://edge-platform.sitecorecloud.io
NEXT_PUBLIC_SITECORE_EDGE_URL=https://edge-platform.sitecorecloud.io

# Required to resolve the correct site locally
NEXT_PUBLIC_DEFAULT_SITE_NAME=hussmann
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# Required for Experience Editor integration
SITECORE_EDITING_SECRET=

# Optional local/disconnected API settings
NEXT_PUBLIC_SITECORE_API_KEY=
NEXT_PUBLIC_SITECORE_API_HOST=

# Search configuration
NEXT_PUBLIC_SEARCH_ENV=prod
NEXT_PUBLIC_SEARCH_CUSTOMER_KEY=
NEXT_PUBLIC_SEARCH_API_KEY=
NEXT_PUBLIC_SEARCH_SOURCE=

# Public base URL for link generation
NEXT_PUBLIC_BASE_URL=http://localhost:3000
